# Kopiera denna fil till .env och fyll i dina riktiga nycklar
# ===========================================================

# Discord-bottens token (hämtas från https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=din_discord_bot_token_har

# Kommaseparerad lista med kanal-ID:n som boten ska lyssna på
# Exempel: DISCORD_CHANNEL_IDS=123456789012345678,987654321098765432
DISCORD_CHANNEL_IDS=

# Kommaseparerad lista med server-ID:n (guild IDs) - valfritt filter
# Lämna tomt för att lyssna på alla servrar som boten är med i
DISCORD_GUILD_IDS=

# Anthropic Claude API-nyckel (hämtas från https://console.anthropic.com/)
ANTHROPIC_API_KEY=din_anthropic_api_nyckel_har

# Claude-modellens ID som ska användas för tolkning av signaler
CLAUDE_MODEL=claude-sonnet-4-6

# TradingView webhook-URL för paper trading
# Skapa en alert i TradingView och använd webhook-URL:en här
TRADINGVIEW_WEBHOOK_URL=https://webhook.tradingview.com/din-unika-url

# Valfri hemlig nyckel som skickas med webhooken för autentisering
TRADINGVIEW_WEBHOOK_SECRET=

# Sökväg till CSV-loggfilen (relativ eller absolut)
LOG_FILE_PATH=signals_log.csv

# Loggnivå: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
