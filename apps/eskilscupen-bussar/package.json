{
  "name": "eskilscupen-bussar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Reseplanerare f\u00f6r Eskilscupens bussar i Helsingborg",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "import": "node scripts/import-timetable.mjs",
    "verify:import": "node scripts/verify-import.mjs",
    "verify:journeys": "vitest run tests/journey-checks.test.ts",
    "maps:candidates": "node scripts/build-map-candidates.mjs",
    "maps:matches": "node scripts/build-google-maps-matches.mjs",
    "maps:report": "node scripts/build-map-report.mjs",
    "maps": "npm run maps:candidates && npm run maps:matches && npm run maps:report",
    "stops:sheet": "node scripts/build-stop-verification-sheet.mjs",
    "stops:apply": "node scripts/apply-verified-bus-stops.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  }
}
